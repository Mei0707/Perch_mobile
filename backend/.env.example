# Provider credentials stay on this server. Never put these in the iOS bundle.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FINNHUB_API_KEY=
HOST=127.0.0.1
PORT=8787
# Required for non-loopback or production hosting: generate a random token
# of at least 32 characters. Give it privately to the demo viewer; never bundle it.
# Shared-token demo only; public multi-user access needs verified per-user identity.
PERCH_API_TOKEN=
PERCH_ANALYTICS_PATH=./data/events.jsonl
# Single-instance demo: count every submitted answer, including failures/cancellations.
PERCH_DAILY_ANSWER_LIMIT=50
# Production quota state must live on persistent storage.
PERCH_BUDGET_PATH=./data/budget.json
NODE_ENV=development
